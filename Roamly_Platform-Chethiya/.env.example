# Environment
NODE_ENV=development
PORT=3000

# Database
# Replace this with your MongoDB Atlas URI for production (e.g., mongodb+srv://...)
MONGODB_URI=mongodb://localhost:27017/roamly

# Authentication
# Change JWT_SECRET to a strong random string in production
JWT_SECRET=supersecretjwtkey123
JWT_EXPIRE=30d

# Initial Admin Seeding (Used by scripts/seedAdmin.js)
ADMIN_EMAIL=admin@roamly.local
ADMIN_PASSWORD=secureAdminPassword!

# OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here

# Email Configuration
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_16_char_app_password
